<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml — Root layout for MainActivity.

    ┌──────────────┬────────────────────────────────────────────┐
    │  Aervox      │                                            │
    │  by Anubhav  │     CONTENT AREA                           │
    │  ─────────── │   (HomeFragment / SettingsFragment)        │
    │  🏠 Home     │                                            │
    │  ⚙ Settings  │                                            │
    │              │                                            │
    └──────────────┴────────────────────────────────────────────┘
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- ── Left navigation panel ──────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/nav_panel"
        android:layout_width="220dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@color/nav_panel_background"
        android:paddingTop="40dp"
        android:paddingBottom="24dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- App wordmark block -->
        <TextView
            android:id="@+id/nav_app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02" />

        <!-- Creator tagline -->
        <TextView
            android:id="@+id/nav_creator_tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_tagline"
            android:textColor="@color/creator_watermark"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />

        <!-- Divider under wordmark -->
        <View
            android:layout_width="32dp"
            android:layout_height="2dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:background="@color/accent_blue" />

        <!-- Home nav item -->
        <TextView
            android:id="@+id/nav_item_home"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/nav_home"
            android:textSize="17sp"
            android:textColor="@color/nav_item_normal"
            android:drawableStart="@drawable/ic_nav_home"
            android:drawablePadding="12dp"
            android:background="@drawable/nav_item_selector"
            android:focusable="true"
            android:nextFocusDown="@id/nav_item_settings"
            android:nextFocusRight="@id/content_container" />

        <!-- Settings nav item -->
        <TextView
            android:id="@+id/nav_item_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/nav_settings"
            android:textSize="17sp"
            android:textColor="@color/nav_item_normal"
            android:drawableStart="@drawable/ic_nav_settings"
            android:drawablePadding="12dp"
            android:background="@drawable/nav_item_selector"
            android:focusable="true"
            android:nextFocusUp="@id/nav_item_home"
            android:nextFocusRight="@id/content_container" />

    </LinearLayout>

    <!-- Vertical divider -->
    <View
        android:id="@+id/nav_divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/divider"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/nav_panel" />

    <!-- ── Main content area ──────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/nav_divider"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Full-screen streaming overlay (GONE when idle) ─────────────── -->
    <FrameLayout
        android:id="@+id/streaming_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
