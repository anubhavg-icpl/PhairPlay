<?xml version="1.0" encoding="utf-8"?>
<!--
    card_protocol_status.xml — Protocol status card (AirPlay / Miracast / Cast).

    ┌──────────────────────────┐
    │  ┌────────┐              │
    │  │ [icon] │ Protocol     │  ← icon in tinted rounded container
    │  └────────┘ Name (bold)  │
    │                          │
    │  ● Status   detail text  │
    └──────────────────────────┘

    When D-pad focused: blue border ring + 5% scale up (tv_focus_scale animator)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/focus_ring_selector"
    android:focusable="true"
    android:stateListAnimator="@animator/tv_focus_scale">

    <!-- Icon row: tinted container + protocol name side-by-side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <!-- Icon container: neutral dark rounded square, icon set programmatically -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_icon_container">

            <ImageView
                android:id="@+id/img_protocol_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_airplay"
                android:contentDescription="" />
        </FrameLayout>

        <!-- Protocol name -->
        <TextView
            android:id="@+id/text_protocol_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Status row: colored dot + state label -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <View
            android:id="@+id/dot_protocol_status"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/status_dot"
            android:layout_marginEnd="7dp" />

        <TextView
            android:id="@+id/text_protocol_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Detail line: sender name when connected, hint when idle -->
    <TextView
        android:id="@+id/text_protocol_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_tertiary"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
